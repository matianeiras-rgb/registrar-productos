<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.registrarproductos.ProductoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <Label text="Registro de Productos">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="txtNombre" promptText="Nombre" />
                <TextField fx:id="txtCategoria" promptText="Categoría" />
                <TextField fx:id="txtPrecio" promptText="Precio" />
                <Button text="Agregar producto" onAction="#agregarProducto" />
            </children>
        </HBox>

        <TableView fx:id="tablaProductos" prefHeight="250.0" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            </columns>
        </TableView>
    </children>
</VBox>